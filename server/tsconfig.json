{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "controllers/**/*.ts",
    "middlewares/**/*.ts",
    "routes/**/*.ts",
    "lib/**/*.ts",
    "types/**/*.d.ts",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}